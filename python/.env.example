# Sinch project access key (Dashboard > Settings > Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=
# Voice API v2 service whose STATIC call behavior answers the number
SINCH_SERVICE_ID=
# Sinch number assigned to SINCH_SERVICE_ID (the number customers call), E.164.
# Also the caller ID shown to technicians.
SINCH_NUMBER=

# Exactly three technician mobiles in dialing order (tech-1, tech-2, tech-3), E.164, comma-separated.
# Repeat a number if you have fewer, e.g. +34600000001,+34600000002,+34600000001
TECHNICIAN_NUMBERS=

# Public WebSocket URL of this server, e.g. wss://<ngrok-host>/relay
RELAY_PUBLIC_URL=
# Public URL of the hold music (e.g. an MP3) played while technicians ring.
# It does not loop: make it at least 3 x DIAL_TIMEOUT_SECONDS plus the whisper (about 70 s).
HOLD_MUSIC_URL=https://samplelib.com/mp3/sample-12s.mp3

# Gemini API key for the AI agent (Google AI Studio > Get API key)
LLM_API_KEY=
